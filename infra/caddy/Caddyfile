# TLS is automatic: Caddy fetches and renews the certificate from Let's Encrypt
# once DNS points ASTRA_DOMAIN at this server. For a first test without a
# domain, set ASTRA_DOMAIN=:80 — plain HTTP on the server's IP.
{
	email {$ACME_EMAIL}
}

{$ASTRA_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	reverse_proxy web:3000

	log {
		output stdout
		format json
	}
}
