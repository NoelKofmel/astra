{
  "name": "astra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.dev.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.dev.yml down",
    "db:generate": "pnpm --filter @astra/db run generate",
    "db:migrate": "pnpm --filter @astra/db run migrate",
    "db:studio": "pnpm --filter @astra/db run studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "eslint": "^10.11.0",
    "eslint-config-next": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "next": "catalog:",
    "prettier": "^3.9.0",
    "turbo": "^2.11.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.0"
  }
}
